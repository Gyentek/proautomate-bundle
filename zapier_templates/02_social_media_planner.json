{
  "name": "Google Sheets → Social Media Auto Planner (Zapier)",
  "trigger": {
    "app": "Google Sheets",
    "event": "New or Updated Spreadsheet Row",
    "config": {
      "spreadsheet": "{{SPREADSHEET_ID}}",
      "worksheet": "Content Calendar",
      "trigger_column": "Status",
      "trigger_value": "Ready"
    }
  },
  "actions": [
    {
      "step": 1,
      "app": "OpenAI (GPT-4, DALL-E, Whisper)",
      "event": "Send Chat Message",
      "config": {
        "model": "gpt-4o-mini",
        "user_message": "Create platform-specific social media content for the following topic:\n\nTopic: {{1__Topic}}\nTone: {{1__Tone}}\nTarget Audience: {{1__Target_Audience}}\n\nReturn JSON: {instagram_caption, instagram_hashtags, twitter_tweet, linkedin_post}",
        "max_tokens": 600
      }
    },
    {
      "step": 2,
      "app": "Buffer",
      "event": "Add to Buffer",
      "config": {
        "profile_ids": ["{{INSTAGRAM_ID}}", "{{TWITTER_ID}}"],
        "text": "{{extract_from_json(2__choices__0__message__content; 'instagram_caption')}} {{extract_from_json(2__choices__0__message__content; 'instagram_hashtags')}}",
        "scheduled_at": "{{1__Publish_Date}}"
      }
    },
    {
      "step": 3,
      "app": "LinkedIn",
      "event": "Create Share Update",
      "config": {
        "text": "{{extract_from_json(2__choices__0__message__content; 'linkedin_post')}}",
        "visibility": "PUBLIC"
      }
    },
    {
      "step": 4,
      "app": "Google Sheets",
      "event": "Update Spreadsheet Row",
      "config": {
        "spreadsheet": "{{SPREADSHEET_ID}}",
        "worksheet": "Content Calendar",
        "row": "{{1__row_number}}",
        "Status": "✅ Scheduled",
        "Completed": "{{zap_meta_humanized_time}}"
      }
    }
  ]
}
