{
  "name": "ChatGPT Content Generator + WordPress (Zapier)",
  "trigger": {
    "app": "Schedule by Zapier",
    "event": "Every Day",
    "config": {
      "time": "06:00 AM"
    }
  },
  "actions": [
    {
      "step": 1,
      "app": "Google Sheets",
      "event": "Lookup Spreadsheet Row",
      "config": {
        "spreadsheet": "{{SPREADSHEET_ID}}",
        "worksheet": "Content Queue",
        "lookup_column": "Status",
        "lookup_value": "To Generate"
      }
    },
    {
      "step": 2,
      "app": "OpenAI (GPT-4, DALL-E, Whisper)",
      "event": "Send Chat Message",
      "config": {
        "model": "gpt-4o",
        "user_message": "Topic: {{1__Topic}}\nKeywords: {{1__Keywords}}\nLanguage: {{1__Language}}\n\nFor this topic, produce:\n1. An SEO-optimized blog title\n2. A meta description (max 160 characters)\n3. 800+ words of HTML blog content\n4. An Instagram caption + hashtags\n5. A Twitter tweet (280 characters)\n6. A LinkedIn post\n\nReturn everything in JSON format.",
        "max_tokens": 3000,
        "system_message": "You are a content strategist and SEO expert."
      }
    },
    {
      "step": 3,
      "app": "WordPress",
      "event": "Create Post",
      "config": {
        "site": "{{WP_SITE}}",
        "title": "{{extract_json(2__choices__0__message__content; 'title')}}",
        "content": "{{extract_json(2__choices__0__message__content; 'content')}}",
        "status": "draft",
        "excerpt": "{{extract_json(2__choices__0__message__content; 'meta_description')}}"
      }
    },
    {
      "step": 4,
      "app": "Notion",
      "event": "Create Database Item",
      "config": {
        "database": "{{NOTION_CONTENT_DB}}",
        "Title": "{{extract_json(2__choices__0__message__content; 'title')}}",
        "Topic": "{{1__Topic}}",
        "Status": "Draft",
        "WP_Link": "{{3__link}}",
        "Date": "{{zap_meta_humanized_time}}"
      }
    },
    {
      "step": 5,
      "app": "Google Sheets",
      "event": "Update Spreadsheet Row",
      "config": {
        "spreadsheet": "{{SPREADSHEET_ID}}",
        "worksheet": "Content Queue",
        "row": "{{1__row_number}}",
        "Status": "✅ Generated",
        "Blog_Link": "{{3__link}}"
      }
    }
  ]
}
