{
  "name": "WooCommerce → Notion CRM (Zapier)",
  "trigger": {
    "app": "WooCommerce",
    "event": "New Order",
    "config": {
      "site_url": "{{WC_SITE_URL}}",
      "consumer_key": "{{WC_KEY}}",
      "consumer_secret": "{{WC_SECRET}}"
    }
  },
  "actions": [
    {
      "step": 1,
      "app": "Notion",
      "event": "Create Database Item",
      "config": {
        "database": "{{NOTION_ORDERS_DB}}",
        "Order No": "#{{1__number}}",
        "Customer": "{{1__billing_first_name}} {{1__billing_last_name}}",
        "Email": "{{1__billing_email}}",
        "Amount": "{{1__total}} {{1__currency}}",
        "Products": "{{1__line_items__0__name}}",
        "Status": "New Order",
        "Date": "{{1__date_created}}"
      }
    },
    {
      "step": 2,
      "app": "Slack",
      "event": "Send Channel Message",
      "config": {
        "channel": "{{SLACK_CHANNEL}}",
        "message": "🛒 *New WooCommerce Order!*\n👤 Customer: {{1__billing_first_name}} {{1__billing_last_name}}\n💰 Amount: {{1__total}} {{1__currency}}\n📦 Product: {{1__line_items__0__name}}\n✅ Added to Notion!"
      }
    }
  ]
}
