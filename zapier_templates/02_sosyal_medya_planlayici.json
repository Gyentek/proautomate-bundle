{
  "name": "Google Sheets → Sosyal Medya Otomatik Planlayıcı (Zapier)",
  "trigger": {
    "app": "Google Sheets",
    "event": "New or Updated Spreadsheet Row",
    "config": {
      "spreadsheet": "{{SPREADSHEET_ID}}",
      "worksheet": "İçerik Takvimi",
      "trigger_column": "Status",
      "trigger_value": "Hazır"
    }
  },
  "actions": [
    {
      "step": 1,
      "app": "OpenAI (GPT-4, DALL-E, Whisper)",
      "event": "Send Chat Message",
      "config": {
        "model": "gpt-4o-mini",
        "user_message": "Şu konu için platforma özel sosyal medya içerikleri oluştur:\n\nKonu: {{1__Konu}}\nTon: {{1__Ton}}\nHedef Kitle: {{1__Hedef_Kitle}}\n\nJSON döndür: {instagram_caption, instagram_hashtags, twitter_tweet, linkedin_post}",
        "max_tokens": 600
      }
    },
    {
      "step": 2,
      "app": "Buffer",
      "event": "Add to Buffer",
      "config": {
        "profile_ids": ["{{INSTAGRAM_ID}}", "{{TWITTER_ID}}"],
        "text": "{{extract_from_json(2__choices__0__message__content; 'instagram_caption')}} {{extract_from_json(2__choices__0__message__content; 'instagram_hashtags')}}",
        "scheduled_at": "{{1__Yayin_Tarihi}}"
      }
    },
    {
      "step": 3,
      "app": "LinkedIn",
      "event": "Create Share Update",
      "config": {
        "text": "{{extract_from_json(2__choices__0__message__content; 'linkedin_post')}}",
        "visibility": "PUBLIC"
      }
    },
    {
      "step": 4,
      "app": "Google Sheets",
      "event": "Update Spreadsheet Row",
      "config": {
        "spreadsheet": "{{SPREADSHEET_ID}}",
        "worksheet": "İçerik Takvimi",
        "row": "{{1__row_number}}",
        "Status": "✅ Planlandı",
        "Tamamlanma": "{{zap_meta_humanized_time}}"
      }
    }
  ]
}
