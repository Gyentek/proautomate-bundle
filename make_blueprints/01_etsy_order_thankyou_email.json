{
  "name": "Etsy Order → Automatic Thank-You Email",
  "description": "When a new Etsy order arrives, automatically sends the customer a personalized thank-you email.",
  "version": 2,
  "metadata": {
    "instant": false,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": false,
      "confidential": false,
      "dataloss": false,
      "dlq": false
    },
    "designer": {
      "orphans": []
    }
  },
  "flow": [
    {
      "id": 1,
      "module": "gateway:CustomWebHook",
      "version": 1,
      "parameters": {
        "hook": "{{ETSY_WEBHOOK_URL}}",
        "maxResults": 1
      },
      "mapper": {},
      "metadata": {
        "designer": { "x": 0, "y": 0 },
        "restore": {
          "parameters": {
            "hook": { "label": "Etsy Order Webhook" }
          }
        },
        "parameters": [
          { "name": "hook", "type": "hook:gateway-webhook", "label": "Webhook", "required": true }
        ]
      }
    },
    {
      "id": 2,
      "module": "util:SetVariable",
      "version": 1,
      "parameters": {},
      "mapper": {
        "name": "customer_name",
        "scope": "roundtrip",
        "value": "{{1.buyer_name}}"
      },
      "metadata": {
        "designer": { "x": 300, "y": 0 },
        "restore": {}
      }
    },
    {
      "id": 3,
      "module": "openai-gpt-4:createChatCompletion",
      "version": 1,
      "parameters": {
        "model": "gpt-4o-mini",
        "messages": [
          {
            "role": "system",
            "content": "You are a customer service assistant for an e-commerce store. You write warm, friendly, and professional emails. Emails should be short, concise, and make the customer feel valued."
          },
          {
            "role": "user",
            "content": "Write a personalized thank-you email using the following details:\n- Customer Name: {{1.buyer_name}}\n- Order Number: {{1.order_id}}\n- Product Name: {{1.product_title}}\n- Order Date: {{1.order_date}}\n\nWrite the email in English. Return it in HTML format."
          }
        ],
        "max_tokens": 600
      },
      "mapper": {},
      "metadata": {
        "designer": { "x": 600, "y": 0 },
        "restore": {
          "parameters": {
            "model": { "label": "GPT-4o Mini" }
          }
        }
      }
    },
    {
      "id": 4,
      "module": "gmail:sendEmail",
      "version": 1,
      "parameters": {
        "account": "{{GMAIL_ACCOUNT}}"
      },
      "mapper": {
        "to": "{{1.buyer_email}}",
        "subject": "🎉 Your Order Is Confirmed! #{{1.order_id}} - Thank You!",
        "html": "{{3.choices[].message.content}}",
        "from": "{{SENDER_NAME}} <{{SENDER_EMAIL}}>"
      },
      "metadata": {
        "designer": { "x": 900, "y": 0 },
        "restore": {
          "parameters": {
            "account": { "label": "Your Gmail Account" }
          }
        }
      }
    },
    {
      "id": 5,
      "module": "google-sheets:addRow",
      "version": 1,
      "parameters": {
        "spreadsheetId": "{{GOOGLE_SHEETS_ID}}",
        "sheetId": "Orders",
        "includesHeaders": true
      },
      "mapper": {
        "values": {
          "Date": "{{formatDate(now; 'DD/MM/YYYY HH:mm')}}",
          "Order No": "{{1.order_id}}",
          "Customer Name": "{{1.buyer_name}}",
          "Email": "{{1.buyer_email}}",
          "Product": "{{1.product_title}}",
          "Amount": "{{1.total_price}}",
          "Email Sent": "✅ Yes"
        }
      },
      "metadata": {
        "designer": { "x": 1200, "y": 0 }
      }
    }
  ],
  "_SETUP_NOTES": {
    "required_accounts": ["Gmail or SMTP", "OpenAI API", "Google Sheets (optional)", "Etsy Webhook"],
    "steps": [
      "1. Log in to your Make.com account",
      "2. Scenarios → Import Blueprint → upload this JSON file",
      "3. Set up the Gmail connection (via OAuth)",
      "4. Enter your OpenAI API key",
      "5. Enter your Google Sheets ID",
      "6. Register the Etsy webhook URL in the Etsy Developer panel",
      "7. Activate the scenario and test it"
    ],
    "what_to_change": {
      "ETSY_WEBHOOK_URL": "The webhook URL that Make.com gives you",
      "GMAIL_ACCOUNT": "The Gmail account you connected",
      "SENDER_NAME": "Your store name",
      "SENDER_EMAIL": "Your sender email address",
      "GOOGLE_SHEETS_ID": "The ID between /d/ and /edit in the Sheets URL"
    }
  }
}
