{
  "name": "Social Media Auto Content Planner",
  "description": "Reads your content calendar in Google Sheets, optimizes it with ChatGPT, and automatically schedules posts to Instagram, Twitter/X, and LinkedIn.",
  "version": 2,
  "metadata": {
    "instant": false,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "sequential": true
    }
  },
  "flow": [
    {
      "id": 1,
      "module": "google-sheets:getRows",
      "version": 1,
      "parameters": {
        "spreadsheetId": "{{GOOGLE_SHEETS_ID}}",
        "sheetId": "Content Calendar",
        "includesHeaders": true,
        "filter": {
          "condition": {
            "a": "{{Status}}",
            "b": "Ready",
            "o": "text:equal"
          }
        }
      },
      "mapper": {},
      "metadata": {
        "designer": { "x": 0, "y": 0 },
        "restore": {}
      }
    },
    {
      "id": 2,
      "module": "openai-gpt-4:createChatCompletion",
      "version": 1,
      "parameters": {
        "model": "gpt-4o-mini",
        "messages": [
          {
            "role": "system",
            "content": "You are a social media expert. You turn a given topic into platform-specific content with high viral potential. Use a distinct tone and format for each platform."
          },
          {
            "role": "user",
            "content": "Generate content for 3 different platforms for the following topic:\n\nTopic: {{1.Topic}}\nTarget Audience: {{1.Target_Audience}}\nBrand Tone: {{1.Tone}}\nHashtag Count: {{1.Hashtag_Count}}\n\nReturn it in JSON format:\n{\n  'instagram': {'caption': '...', 'hashtags': '...'},\n  'twitter': {'tweet': '...'},\n  'linkedin': {'post': '...'}\n}"
          }
        ],
        "max_tokens": 800,
        "response_format": "json_object"
      },
      "mapper": {},
      "metadata": {
        "designer": { "x": 300, "y": 0 }
      }
    },
    {
      "id": 3,
      "module": "json:ParseJSON",
      "version": 1,
      "parameters": {},
      "mapper": {
        "json": "{{2.choices[].message.content}}"
      },
      "metadata": {
        "designer": { "x": 600, "y": 0 }
      }
    },
    {
      "id": 4,
      "module": "buffer:CreateSchedule",
      "version": 1,
      "parameters": {
        "account": "{{BUFFER_ACCOUNT}}"
      },
      "mapper": {
        "profile_ids": ["{{INSTAGRAM_PROFILE_ID}}", "{{TWITTER_PROFILE_ID}}", "{{LINKEDIN_PROFILE_ID}}"],
        "text": "{{3.instagram.caption}} {{3.instagram.hashtags}}",
        "scheduled_at": "{{1.Publish_Date}}"
      },
      "metadata": {
        "designer": { "x": 900, "y": 0 }
      }
    },
    {
      "id": 5,
      "module": "google-sheets:updateRow",
      "version": 1,
      "parameters": {
        "spreadsheetId": "{{GOOGLE_SHEETS_ID}}",
        "sheetId": "Content Calendar",
        "rowNumber": "{{1.__ROW_NUMBER__}}"
      },
      "mapper": {
        "Status": "✅ Scheduled",
        "Scheduled_Date": "{{formatDate(now; 'DD/MM/YYYY HH:mm')}}",
        "Buffer_ID": "{{4.id}}"
      },
      "metadata": {
        "designer": { "x": 1200, "y": 0 }
      }
    },
    {
      "id": 6,
      "module": "slack:postMessage",
      "version": 1,
      "parameters": {
        "account": "{{SLACK_ACCOUNT}}"
      },
      "mapper": {
        "channel": "{{SLACK_CHANNEL}}",
        "text": "✅ *New Content Scheduled!*\n📅 Date: {{1.Publish_Date}}\n📝 Topic: {{1.Topic}}\n📱 Platforms: Instagram, Twitter, LinkedIn"
      },
      "metadata": {
        "designer": { "x": 1500, "y": 0 }
      }
    }
  ],
  "_SETUP_NOTES": {
    "required_accounts": ["Google Sheets", "OpenAI API", "Buffer or Hootsuite", "Slack (optional)"],
    "sheets_columns": ["Topic", "Target_Audience", "Tone", "Hashtag_Count", "Publish_Date", "Status", "Scheduled_Date", "Buffer_ID"],
    "run_time": "Runs automatically every day at 8:00 AM and processes rows with a 'Ready' status",
    "what_to_change": {
      "GOOGLE_SHEETS_ID": "The content calendar spreadsheet ID",
      "BUFFER_ACCOUNT": "Buffer OAuth connection",
      "INSTAGRAM_PROFILE_ID": "Instagram profile ID in Buffer",
      "TWITTER_PROFILE_ID": "Twitter profile ID in Buffer",
      "LINKEDIN_PROFILE_ID": "LinkedIn profile ID in Buffer",
      "SLACK_ACCOUNT": "Slack OAuth connection",
      "SLACK_CHANNEL": "#social-media or any channel you prefer"
    }
  }
}
