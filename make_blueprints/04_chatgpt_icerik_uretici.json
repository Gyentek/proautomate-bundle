{
  "name": "ChatGPT Otomatik İçerik Üretici + Çoklu Dağıtım",
  "description": "Anahtar kelimelerden blog yazısı, sosyal medya içeriği, e-posta bülteni üretir ve WordPress, Mailchimp ve Notion'a otomatik olarak dağıtır.",
  "version": 2,
  "metadata": {
    "instant": false,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "sequential": true
    }
  },
  "flow": [
    {
      "id": 1,
      "module": "google-sheets:getRows",
      "version": 1,
      "parameters": {
        "spreadsheetId": "{{GOOGLE_SHEETS_ID}}",
        "sheetId": "İçerik Kuyruğu",
        "includesHeaders": true,
        "filter": {
          "condition": {
            "a": "{{Durum}}",
            "b": "Üretilecek",
            "o": "text:equal"
          }
        },
        "limit": 5
      },
      "mapper": {},
      "metadata": {
        "designer": { "x": 0, "y": 0 }
      }
    },
    {
      "id": 2,
      "module": "openai-gpt-4:createChatCompletion",
      "version": 1,
      "parameters": {
        "model": "gpt-4o",
        "messages": [
          {
            "role": "system",
            "content": "Sen bir içerik stratejisti ve metin yazarısın. Verilen konuda kapsamlı, SEO optimizeli, okunması kolay içerikler üretiyorsun. Çıktını her zaman JSON formatında veriyorsun."
          },
          {
            "role": "user",
            "content": "Şu bilgilerle kapsamlı içerik paketi oluştur:\n\nKonu: {{1.Konu}}\nAnahtar Kelimeler: {{1.Anahtar_Kelimeler}}\nDil: {{1.Dil}}\nHedef Kitle: {{1.Hedef_Kitle}}\nTon: {{1.Ton}}\nKategori: {{1.Kategori}}\n\nJSON formatında döndür:\n{\n  'blog': {\n    'baslik': '...',\n    'meta_aciklama': '... (max 160 karakter)',\n    'icerik': '... (HTML formatında, min 800 kelime)',\n    'etiketler': ['...', '...'],\n    'slug': '...'\n  },\n  'sosyal_medya': {\n    'instagram': '... (hashtag dahil)',\n    'twitter': '... (280 karakter)',\n    'linkedin': '... (profesyonel ton)'\n  },\n  'email_bulten': {\n    'konu_satiri': '...',\n    'on_baslik': '...',\n    'icerik': '... (HTML)'\n  }\n}"
          }
        ],
        "max_tokens": 3000,
        "response_format": "json_object"
      },
      "mapper": {},
      "metadata": {
        "designer": { "x": 300, "y": 0 }
      }
    },
    {
      "id": 3,
      "module": "json:ParseJSON",
      "version": 1,
      "parameters": {},
      "mapper": {
        "json": "{{2.choices[].message.content}}"
      },
      "metadata": {
        "designer": { "x": 600, "y": 0 }
      }
    },
    {
      "id": 4,
      "module": "wordpress:createPost",
      "version": 1,
      "parameters": {
        "site": "{{WORDPRESS_SITE_URL}}",
        "username": "{{WP_USERNAME}}",
        "password": "{{WP_APP_PASSWORD}}"
      },
      "mapper": {
        "title": "{{3.blog.baslik}}",
        "content": "{{3.blog.icerik}}",
        "status": "draft",
        "slug": "{{3.blog.slug}}",
        "excerpt": "{{3.blog.meta_aciklama}}",
        "tags": "{{join(3.blog.etiketler; ',')}}"
      },
      "metadata": {
        "designer": { "x": 900, "y": -150 }
      }
    },
    {
      "id": 5,
      "module": "mailchimp:createCampaign",
      "version": 1,
      "parameters": {
        "account": "{{MAILCHIMP_ACCOUNT}}",
        "type": "regular"
      },
      "mapper": {
        "settings": {
          "subject_line": "{{3.email_bulten.konu_satiri}}",
          "preview_text": "{{3.email_bulten.on_baslik}}",
          "title": "{{1.Konu}} - {{formatDate(now; 'DD/MM/YYYY')}}",
          "from_name": "{{SENDER_NAME}}",
          "reply_to": "{{SENDER_EMAIL}}",
          "auto_footer": true
        },
        "recipients": {
          "list_id": "{{MAILCHIMP_LIST_ID}}"
        }
      },
      "metadata": {
        "designer": { "x": 900, "y": 0 }
      }
    },
    {
      "id": 6,
      "module": "notion:createRecord",
      "version": 1,
      "parameters": {
        "account": "{{NOTION_ACCOUNT}}",
        "database": "{{NOTION_CONTENT_DB_ID}}"
      },
      "mapper": {
        "properties": {
          "Başlık": { "title": [{ "text": { "content": "{{3.blog.baslik}}" } }] },
          "Konu": { "rich_text": [{ "text": { "content": "{{1.Konu}}" } }] },
          "Durum": { "select": { "name": "Taslak" } },
          "Oluşturma Tarihi": { "date": { "start": "{{formatDate(now; 'YYYY-MM-DD')}}" } },
          "WordPress Linki": { "url": "{{4.link}}" },
          "Blog İçeriği": { "rich_text": [{ "text": { "content": "{{substring(3.blog.icerik; 0; 2000)}}" } }] },
          "Instagram": { "rich_text": [{ "text": { "content": "{{3.sosyal_medya.instagram}}" } }] },
          "Twitter": { "rich_text": [{ "text": { "content": "{{3.sosyal_medya.twitter}}" } }] },
          "LinkedIn": { "rich_text": [{ "text": { "content": "{{3.sosyal_medya.linkedin}}" } }] }
        }
      },
      "metadata": {
        "designer": { "x": 900, "y": 150 }
      }
    },
    {
      "id": 7,
      "module": "google-sheets:updateRow",
      "version": 1,
      "parameters": {
        "spreadsheetId": "{{GOOGLE_SHEETS_ID}}",
        "sheetId": "İçerik Kuyruğu",
        "rowNumber": "{{1.__ROW_NUMBER__}}"
      },
      "mapper": {
        "Durum": "✅ Üretildi",
        "Tamamlanma_Tarihi": "{{formatDate(now; 'DD/MM/YYYY HH:mm')}}",
        "Blog_Basligi": "{{3.blog.baslik}}",
        "WP_Link": "{{4.link}}",
        "Notion_ID": "{{6.id}}"
      },
      "metadata": {
        "designer": { "x": 1200, "y": 0 }
      }
    }
  ],
  "_SETUP_NOTES": {
    "gerekli_hesaplar": ["Google Sheets", "OpenAI API (GPT-4o)", "WordPress", "Mailchimp", "Notion"],
    "sheets_sutunlari": ["Konu", "Anahtar_Kelimeler", "Dil", "Hedef_Kitle", "Ton", "Kategori", "Durum", "Tamamlanma_Tarihi", "Blog_Basligi", "WP_Link", "Notion_ID"],
    "calisma_zamani": "Her gün saat 06:00'da çalışır ve 5 içeriğe kadar işler",
    "degistirmeniz_gerekenler": {
      "GOOGLE_SHEETS_ID": "İçerik kuyruğu spreadsheet ID",
      "WORDPRESS_SITE_URL": "https://siteniz.com",
      "WP_USERNAME": "WordPress kullanıcı adı",
      "WP_APP_PASSWORD": "WordPress > Profil > Uygulama Şifreleri",
      "MAILCHIMP_ACCOUNT": "Mailchimp OAuth",
      "MAILCHIMP_LIST_ID": "Mailchimp Audience ID",
      "NOTION_ACCOUNT": "Notion OAuth",
      "NOTION_CONTENT_DB_ID": "İçerik veritabanı ID",
      "SENDER_NAME": "Bülten gönderici adı",
      "SENDER_EMAIL": "Bülten gönderici e-posta"
    }
  }
}
