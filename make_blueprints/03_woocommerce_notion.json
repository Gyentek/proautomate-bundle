{
  "name": "WooCommerce Order → Notion CRM",
  "description": "Automatically adds every new WooCommerce order to a Notion database, creates a customer record, and notifies your team.",
  "version": 2,
  "metadata": {
    "instant": true,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "sequential": false
    }
  },
  "flow": [
    {
      "id": 1,
      "module": "woocommerce:TriggerNewOrder",
      "version": 1,
      "parameters": {
        "site": "{{WOOCOMMERCE_SITE_URL}}",
        "consumer_key": "{{WC_CONSUMER_KEY}}",
        "consumer_secret": "{{WC_CONSUMER_SECRET}}"
      },
      "mapper": {},
      "metadata": {
        "designer": { "x": 0, "y": 0 }
      }
    },
    {
      "id": 2,
      "module": "notion:searchObjects",
      "version": 1,
      "parameters": {
        "account": "{{NOTION_ACCOUNT}}",
        "type": "database",
        "database": "{{NOTION_CUSTOMERS_DB_ID}}",
        "filterType": "database"
      },
      "mapper": {
        "query": "{{1.billing.email}}"
      },
      "metadata": {
        "designer": { "x": 300, "y": 0 }
      }
    },
    {
      "id": 3,
      "module": "notion:createRecord",
      "version": 1,
      "parameters": {
        "account": "{{NOTION_ACCOUNT}}",
        "database": "{{NOTION_ORDERS_DB_ID}}"
      },
      "mapper": {
        "properties": {
          "Order No": { "title": [{ "text": { "content": "#{{1.number}}" } }] },
          "Customer": { "rich_text": [{ "text": { "content": "{{1.billing.first_name}} {{1.billing.last_name}}" } }] },
          "Email": { "email": "{{1.billing.email}}" },
          "Phone": { "phone_number": "{{1.billing.phone}}" },
          "Amount": { "number": "{{toNumber(1.total)}}" },
          "Currency": { "select": { "name": "{{1.currency}}" } },
          "Status": { "select": { "name": "New Order" } },
          "Products": { "rich_text": [{ "text": { "content": "{{join(map(1.line_items; 'name'); ', ')}}" } }] },
          "Order Date": { "date": { "start": "{{1.date_created}}" } },
          "Country": { "select": { "name": "{{1.billing.country}}" } },
          "Payment Method": { "select": { "name": "{{1.payment_method_title}}" } },
          "WC Link": { "url": "{{WOOCOMMERCE_SITE_URL}}/wp-admin/post.php?post={{1.id}}&action=edit" }
        }
      },
      "metadata": {
        "designer": { "x": 600, "y": 0 }
      }
    },
    {
      "id": 4,
      "module": "openai-gpt-4:createChatCompletion",
      "version": 1,
      "parameters": {
        "model": "gpt-4o-mini",
        "messages": [
          {
            "role": "user",
            "content": "Write a short customer assessment note for the following WooCommerce order (3-4 sentences, in English):\n- Customer: {{1.billing.first_name}} {{1.billing.last_name}}\n- Amount: {{1.total}} {{1.currency}}\n- Products: {{join(map(1.line_items; 'name'); ', ')}}\n- Country: {{1.billing.country}}\n- Payment: {{1.payment_method_title}}\n\nInclude the customer segment, order value, and potential notes."
          }
        ],
        "max_tokens": 200
      },
      "mapper": {},
      "metadata": {
        "designer": { "x": 900, "y": 0 }
      }
    },
    {
      "id": 5,
      "module": "slack:postMessage",
      "version": 1,
      "parameters": {
        "account": "{{SLACK_ACCOUNT}}"
      },
      "mapper": {
        "channel": "{{SLACK_ORDERS_CHANNEL}}",
        "blocks": [
          {
            "type": "header",
            "text": { "type": "plain_text", "text": "🛒 New Order #{{1.number}}" }
          },
          {
            "type": "section",
            "fields": [
              { "type": "mrkdwn", "text": "*Customer:*\n{{1.billing.first_name}} {{1.billing.last_name}}" },
              { "type": "mrkdwn", "text": "*Amount:*\n{{1.total}} {{1.currency}}" },
              { "type": "mrkdwn", "text": "*Products:*\n{{join(map(1.line_items; 'name'); ', ')}}" },
              { "type": "mrkdwn", "text": "*Status:*\n✅ Added to Notion" }
            ]
          },
          {
            "type": "section",
            "text": { "type": "mrkdwn", "text": "*AI Note:* {{4.choices[].message.content}}" }
          }
        ]
      },
      "metadata": {
        "designer": { "x": 1200, "y": 0 }
      }
    }
  ],
  "_SETUP_NOTES": {
    "required_accounts": ["WooCommerce (API key)", "Notion (integration)", "OpenAI API", "Slack"],
    "notion_databases": {
      "Orders": ["Order No", "Customer", "Email", "Phone", "Amount", "Currency", "Status", "Products", "Order Date", "Country", "Payment Method", "WC Link"],
      "Customers": ["Full Name", "Email", "Total Spend", "Order Count", "Last Order"]
    },
    "what_to_change": {
      "WOOCOMMERCE_SITE_URL": "https://yoursite.com",
      "WC_CONSUMER_KEY": "WooCommerce API > Consumer Key",
      "WC_CONSUMER_SECRET": "WooCommerce API > Consumer Secret",
      "NOTION_ACCOUNT": "Notion OAuth connection",
      "NOTION_ORDERS_DB_ID": "The 32-character ID in the Orders database URL",
      "NOTION_CUSTOMERS_DB_ID": "Customers database ID",
      "SLACK_ACCOUNT": "Slack OAuth",
      "SLACK_ORDERS_CHANNEL": "#orders"
    }
  }
}
