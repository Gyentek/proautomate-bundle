{
  "name": "ChatGPT Auto Content Generator + Multi-Channel Distribution",
  "description": "Generates a blog post, social media content, and an email newsletter from keywords, and automatically distributes them to WordPress, Mailchimp, and Notion.",
  "version": 2,
  "metadata": {
    "instant": false,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "sequential": true
    }
  },
  "flow": [
    {
      "id": 1,
      "module": "google-sheets:getRows",
      "version": 1,
      "parameters": {
        "spreadsheetId": "{{GOOGLE_SHEETS_ID}}",
        "sheetId": "Content Queue",
        "includesHeaders": true,
        "filter": {
          "condition": {
            "a": "{{Status}}",
            "b": "To Generate",
            "o": "text:equal"
          }
        },
        "limit": 5
      },
      "mapper": {},
      "metadata": {
        "designer": { "x": 0, "y": 0 }
      }
    },
    {
      "id": 2,
      "module": "openai-gpt-4:createChatCompletion",
      "version": 1,
      "parameters": {
        "model": "gpt-4o",
        "messages": [
          {
            "role": "system",
            "content": "You are a content strategist and copywriter. You produce comprehensive, SEO-optimized, easy-to-read content on a given topic. You always return your output in JSON format."
          },
          {
            "role": "user",
            "content": "Create a comprehensive content package using the following details:\n\nTopic: {{1.Topic}}\nKeywords: {{1.Keywords}}\nLanguage: {{1.Language}}\nTarget Audience: {{1.Target_Audience}}\nTone: {{1.Tone}}\nCategory: {{1.Category}}\n\nReturn it in JSON format:\n{\n  'blog': {\n    'title': '...',\n    'meta_description': '... (max 160 characters)',\n    'content': '... (in HTML format, min 800 words)',\n    'tags': ['...', '...'],\n    'slug': '...'\n  },\n  'social_media': {\n    'instagram': '... (including hashtags)',\n    'twitter': '... (280 characters)',\n    'linkedin': '... (professional tone)'\n  },\n  'email_newsletter': {\n    'subject_line': '...',\n    'preview_text': '...',\n    'content': '... (HTML)'\n  }\n}"
          }
        ],
        "max_tokens": 3000,
        "response_format": "json_object"
      },
      "mapper": {},
      "metadata": {
        "designer": { "x": 300, "y": 0 }
      }
    },
    {
      "id": 3,
      "module": "json:ParseJSON",
      "version": 1,
      "parameters": {},
      "mapper": {
        "json": "{{2.choices[].message.content}}"
      },
      "metadata": {
        "designer": { "x": 600, "y": 0 }
      }
    },
    {
      "id": 4,
      "module": "wordpress:createPost",
      "version": 1,
      "parameters": {
        "site": "{{WORDPRESS_SITE_URL}}",
        "username": "{{WP_USERNAME}}",
        "password": "{{WP_APP_PASSWORD}}"
      },
      "mapper": {
        "title": "{{3.blog.title}}",
        "content": "{{3.blog.content}}",
        "status": "draft",
        "slug": "{{3.blog.slug}}",
        "excerpt": "{{3.blog.meta_description}}",
        "tags": "{{join(3.blog.tags; ',')}}"
      },
      "metadata": {
        "designer": { "x": 900, "y": -150 }
      }
    },
    {
      "id": 5,
      "module": "mailchimp:createCampaign",
      "version": 1,
      "parameters": {
        "account": "{{MAILCHIMP_ACCOUNT}}",
        "type": "regular"
      },
      "mapper": {
        "settings": {
          "subject_line": "{{3.email_newsletter.subject_line}}",
          "preview_text": "{{3.email_newsletter.preview_text}}",
          "title": "{{1.Topic}} - {{formatDate(now; 'DD/MM/YYYY')}}",
          "from_name": "{{SENDER_NAME}}",
          "reply_to": "{{SENDER_EMAIL}}",
          "auto_footer": true
        },
        "recipients": {
          "list_id": "{{MAILCHIMP_LIST_ID}}"
        }
      },
      "metadata": {
        "designer": { "x": 900, "y": 0 }
      }
    },
    {
      "id": 6,
      "module": "notion:createRecord",
      "version": 1,
      "parameters": {
        "account": "{{NOTION_ACCOUNT}}",
        "database": "{{NOTION_CONTENT_DB_ID}}"
      },
      "mapper": {
        "properties": {
          "Title": { "title": [{ "text": { "content": "{{3.blog.title}}" } }] },
          "Topic": { "rich_text": [{ "text": { "content": "{{1.Topic}}" } }] },
          "Status": { "select": { "name": "Draft" } },
          "Created Date": { "date": { "start": "{{formatDate(now; 'YYYY-MM-DD')}}" } },
          "WordPress Link": { "url": "{{4.link}}" },
          "Blog Content": { "rich_text": [{ "text": { "content": "{{substring(3.blog.content; 0; 2000)}}" } }] },
          "Instagram": { "rich_text": [{ "text": { "content": "{{3.social_media.instagram}}" } }] },
          "Twitter": { "rich_text": [{ "text": { "content": "{{3.social_media.twitter}}" } }] },
          "LinkedIn": { "rich_text": [{ "text": { "content": "{{3.social_media.linkedin}}" } }] }
        }
      },
      "metadata": {
        "designer": { "x": 900, "y": 150 }
      }
    },
    {
      "id": 7,
      "module": "google-sheets:updateRow",
      "version": 1,
      "parameters": {
        "spreadsheetId": "{{GOOGLE_SHEETS_ID}}",
        "sheetId": "Content Queue",
        "rowNumber": "{{1.__ROW_NUMBER__}}"
      },
      "mapper": {
        "Status": "✅ Generated",
        "Completion_Date": "{{formatDate(now; 'DD/MM/YYYY HH:mm')}}",
        "Blog_Title": "{{3.blog.title}}",
        "WP_Link": "{{4.link}}",
        "Notion_ID": "{{6.id}}"
      },
      "metadata": {
        "designer": { "x": 1200, "y": 0 }
      }
    }
  ],
  "_SETUP_NOTES": {
    "required_accounts": ["Google Sheets", "OpenAI API (GPT-4o)", "WordPress", "Mailchimp", "Notion"],
    "sheets_columns": ["Topic", "Keywords", "Language", "Target_Audience", "Tone", "Category", "Status", "Completion_Date", "Blog_Title", "WP_Link", "Notion_ID"],
    "run_time": "Runs every day at 6:00 AM and processes up to 5 pieces of content",
    "what_to_change": {
      "GOOGLE_SHEETS_ID": "Content queue spreadsheet ID",
      "WORDPRESS_SITE_URL": "https://yoursite.com",
      "WP_USERNAME": "WordPress username",
      "WP_APP_PASSWORD": "WordPress > Profile > Application Passwords",
      "MAILCHIMP_ACCOUNT": "Mailchimp OAuth",
      "MAILCHIMP_LIST_ID": "Mailchimp Audience ID",
      "NOTION_ACCOUNT": "Notion OAuth",
      "NOTION_CONTENT_DB_ID": "Content database ID",
      "SENDER_NAME": "Newsletter sender name",
      "SENDER_EMAIL": "Newsletter sender email"
    }
  }
}
